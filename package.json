{
  "name": "theme-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 7777",
    "build": "tsc -b && vp build",
    "preview": "vp preview --port 4174",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "vp config"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.20.0"
}
